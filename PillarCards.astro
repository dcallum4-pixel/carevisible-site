---
import { pillars } from '../data/site';
---

<div class="grid grid-4 pillar-grid">
  {pillars.map((p, i) => (
    <article class="card card-accent pillar">
      <span class="pillar-num">{String(i + 1).padStart(2, '0')}</span>
      <h3>{p.name}</h3>
      <p class="pillar-sum">{p.summary}</p>
      <p class="pillar-why">{p.why}</p>
      <span class="pillar-weight">{p.max} of 100 points</span>
    </article>
  ))}
</div>

<style>
  .pillar { position: relative; display: flex; flex-direction: column; }
  .pillar-num {
    font-size: .78rem;
    font-weight: 800;
    color: var(--coral);
    letter-spacing: .08em;
  }
  .pillar h3 { margin: 6px 0 10px; font-size: 1.06rem; }
  .pillar-sum { font-size: .92rem; margin-bottom: 12px; }
  .pillar-why {
    font-size: .86rem;
    color: var(--ink-soft);
    border-left: 2px solid var(--coral-soft);
    padding-left: 12px;
    margin-bottom: 16px;
  }
  .pillar-weight {
    margin-top: auto;
    font-size: .76rem;
    font-weight: 700;
    color: var(--indigo);
    background: var(--surface-alt);
    padding: 5px 10px;
    border-radius: 999px;
    align-self: flex-start;
  }
</style>
